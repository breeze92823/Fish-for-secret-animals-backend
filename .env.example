# Copy to .env (gitignored) for local development. None of these are
# required to run `npm start` -- every one degrades gracefully when unset.

# MongoDB connection string for player-progress persistence. Bloxity Legion
# hosting injects this per game+channel in deployed environments; leave unset
# locally to run with persistence disabled (progress lasts the connection only).
MONGODB_URI=

# CORS allow-origin for deployed environments. Falls back to "*" when unset.
CLIENT_ORIGIN=

# HTTP port. Falls back to 2567 when unset.
PORT=2567

# --- Bloxity (injected by Bloxity Legion hosting when deployed; leave unset locally) ---
# The game's slug: ad-reward tokens are verified against it. Defaults to the client's GAME_SLUG.
BLOXITY_GAME_ID=
# Bloxity API base for token / ad verification. Defaults to prod (or the client's own bloxity.io apiUrl).
BLOXITY_API_URL=
# Bearer token for hosted leaderboard reports and the Open Rooms reporter, and the matchmaker's report URL.
BLOXITY_REPORT_TOKEN=
MATCHMAKER_REPORT_URL=

# A client-sent user id is already believed whenever NODE_ENV is not production (local dev). Setting this
# to "true" extends that to production: never set it on a real deploy.
# ALLOW_CLIENT_IDS=
